# === Default: ignore everything at root (keep process/governance files local) ===
/*

# === Public deliverables (docs, schema, and Ego Pod Python package) ===
!/docs/
!/schema/
!/README.md
!/LICENSE
!/.gitignore
!/release/
/release/*
!/release/dev/
/release/dev/*
!/release/dev/pyproject.toml
!/release/dev/README.md
!/release/dev/src/
!/release/dev/tests/

# === Exclude build/cache/OS noise inside allowed directories ===
.DS_Store
*.swp
*.swo
*~
Thumbs.db
__pycache__/
*.py[cod]
*.egg-info/
.hypothesis/
.pytest_cache/
build/
dist/
.ego/
ego-output/
